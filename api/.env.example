# Copy to .env and fill in what you have. Everything is optional for local use.

# Database. SQLite by default; for PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://threatlens:threatlens@localhost:5432/threatlens
DATABASE_URL=sqlite:///./threatlens.db

# Claude (LLM agents). Without a key the pipeline runs in offline mode
# (regex + heuristics + templates), which is useful for demos but much weaker.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Open-web search for source discovery (Brave Search API). Without it, discovery
# uses seed URLs plus the allow-listed vendor RSS feeds.
BRAVE_SEARCH_API_KEY=

# OSINT keys can also be set in Settings > OSINT API keys (stored in the DB).
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
ABUSECH_AUTH_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=

# Public URL of the web app, used in "Read the full report" links in exports.
WEB_BASE_URL=http://localhost:3000

# Daily emerging-threat digest. Once a day (UTC) ThreatLens ranks what the vendor feeds published, researches the
# top threats for DIGEST_WORKSPACE_ID (first workspace if empty) and emails the report + hunt queries.
# Without SMTP_HOST the email is saved to data/exports/digests/*.eml instead.
DIGEST_ENABLED=false
DIGEST_TIME_UTC=06:30
DIGEST_RECIPIENTS=
DIGEST_WORKSPACE_ID=
DIGEST_MAX_THREATS=3
DIGEST_LOOKBACK_HOURS=36
DIGEST_AUTO_RESEARCH=true
DIGEST_DEPTH=quick
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ThreatLens <threatlens@localhost>
SMTP_STARTTLS=true
